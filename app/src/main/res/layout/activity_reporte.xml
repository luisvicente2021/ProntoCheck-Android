<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER dentro del scroll -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reporte de asistencia"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona período y residencial"
                android:textSize="13sp"
                android:textColor="#8A8FA3"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD FECHAS Y FILTRO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Fecha inicio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fecha inicio"
                                android:textSize="12sp"
                                android:textColor="#8A8FA3"/>
                            <TextView
                                android:id="@+id/tvFechaInicio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Seleccionar"
                                android:textSize="15sp"
                                android:textColor="#1A1A2E"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSeleccionarInicio"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Elegir"
                            android:textColor="#3B82F6"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#EBEBEB"/>

                    <!-- Fecha fin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fecha fin"
                                android:textSize="12sp"
                                android:textColor="#8A8FA3"/>
                            <TextView
                                android:id="@+id/tvFechaFin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Seleccionar"
                                android:textSize="15sp"
                                android:textColor="#1A1A2E"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSeleccionarFin"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Elegir"
                            android:textColor="#3B82F6"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#EBEBEB"/>

                    <!-- Filtro Residencial -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Residencial"
                            android:textSize="12sp"
                            android:textColor="#8A8FA3"/>

                        <Spinner
                            android:id="@+id/spinnerResidencial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN GENERAR -->
            <Button
                android:id="@+id/btnGenerarReporte"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Generar reporte"
                android:backgroundTint="#1A1A2E"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <!-- ESTADO CARGANDO -->
            <LinearLayout
                android:id="@+id/layoutCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="#1A1A2E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generando reporte..."
                    android:textSize="14sp"
                    android:textColor="#8A8FA3"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- ESTADO VACÍO -->
            <LinearLayout
                android:id="@+id/layoutVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvMensajeVacio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecciona las fechas y presiona Generar"
                    android:textSize="14sp"
                    android:textColor="#8A8FA3"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- RESUMEN + BOTÓN PDF -->
            <LinearLayout
                android:id="@+id/layoutResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResumen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <Button
                    android:id="@+id/btnExportarPDF"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Exportar PDF"
                    android:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>

            <!-- LISTA RESULTADOS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>