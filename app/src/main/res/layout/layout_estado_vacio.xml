<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Icono opcional (puedes usar uno de Android) -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_menu_search"
        android:contentDescription="Sin datos"
        android:alpha="0.5"/>

    <!-- ESTE ES EL ID QUE KOTLIN ESTÁ BUSCANDO -->
    <TextView
        android:id="@+id/tvMensajeVacio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="No hay registros disponibles"
        android:textSize="16sp"
        android:textColor="#8A8FA3"
        android:textAlignment="center" />

</LinearLayout>