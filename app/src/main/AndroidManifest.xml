<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.prontocheck">

    <!-- Permisos (están correctos) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProntoCheck"
        tools:targetApi="31">

        <!-- Login -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.dashboard.DashboardActivity" android:exported="false" />
        <activity android:name=".ui.AltaEmpleado.AltaEmpleadoActivity" android:windowSoftInputMode="adjustResize" android:exported="false" />
        <activity android:name=".ui.GestionPersonalActivity" android:exported="false" />
        <activity android:name=".ui.EditarEmpleadoActivity" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".ui.reporte.ReporteActivity" android:screenOrientation="portrait" android:exported="false"/>

        <!-- AGREGAR ESTA LÍNEA PARA LAS GEOCERCAS -->
        <activity
            android:name=".ui.gestionUbicaciones.GestionUbicacionesActivity"
            android:screenOrientation="portrait"
            android:exported="false"/>


        <activity android:name=".RelojActivity" android:screenOrientation="portrait" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <activity
            android:name=".ui.Incidencias.IncidenciasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.Formatos.FormatosActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.Formatos.TurnosActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.cuadrante.CuadranteActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.productos.InventarioActivity"
            android:screenOrientation="portrait"
            android:exported="false" />


    </application>
</manifest>